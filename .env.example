# Telegram Bot Configuration
# Create a bot via @BotFather and obtain your bot token:
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN

# Your Telegram user ID or group Chat ID (e.g. from @userinfobot or @GetIDsBot):
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

# Optional: Supabase configuration (for persistent PostgreSQL database)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: Google Sheets Webhook URL (Google Apps Script web app endpoint)
# GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/.../exec

