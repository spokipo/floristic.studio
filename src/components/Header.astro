---
const navLinks = [
  { href: '/catalog', label: 'Каталог' },
  { href: '/prostir', label: 'Простір' },
  { href: '/about', label: 'Про нас' },
  { href: '/delivery', label: 'Доставка' },
];
---

<header id="site-header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 bg-[#FAF7F2] py-6" transition:persist="header" transition:name="site-header">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between relative z-50">
    <!-- Mobile Menu Toggle -->
    <div class="flex lg:hidden w-1/3">
      <button id="mobile-menu-toggle" class="text-[#1A1A1A] p-2 -ml-2 hover:opacity-70 transition-opacity" aria-label="Меню">
        <svg id="menu-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16"></path></svg>
        <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12"></path></svg>
      </button>
    </div>

    <!-- Desktop Navigation -->
    <nav class="hidden lg:flex items-center gap-8 w-1/3 relative" id="desktop-nav">
      {navLinks.map((link) => {
        return (
          <a
            href={link.href}
            class="nav-link relative text-[11px] uppercase tracking-widest transition-colors pb-1 text-[#1A1A1A]/60 hover:text-[#1A1A1A]"
            data-href={link.href}
          >
            {link.label}
          </a>
        );
      })}
      <!-- Magic Underline -->
      <div id="magic-underline" class="absolute bottom-0 h-[1px] bg-[#1A1A1A] transition-all duration-300 ease-out opacity-0"></div>
    </nav>

    <!-- Center: Brand Logo -->
    <div class="w-1/3 flex justify-center">
      <a href="/" id="brand-logo" class="font-normal text-2xl lg:text-3xl text-[#1A1A1A] tracking-wide shrink-0">
        Floral Studio
      </a>
    </div>

    <!-- Right Actions -->
    <div class="w-1/3 flex justify-end items-center gap-4 sm:gap-6">
      <a href="https://t.me/floral_studio_odesa" target="_blank" rel="noopener noreferrer" class="hidden sm:block text-[11px] uppercase tracking-widest text-[#1A1A1A]/60 hover:text-[#1A1A1A] transition-colors">
        Зв'язок
      </a>

      <button id="cart-toggle" class="text-[#1A1A1A] flex items-center justify-center hover:opacity-70 transition-opacity p-2 -mr-2" aria-label="Кошик">
        <div class="relative">
          <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg>
          <span id="cart-badge" class="hidden text-[10px] font-medium bg-[#1A1A1A] text-white w-4 h-4 rounded-full flex items-center justify-center absolute -top-1 -right-2 border border-[#FAF7F2]">
            0
          </span>
        </div>
      </button>
    </div>
  </div>

  <!-- Mobile Fullscreen Menu Overlay -->
  <div id="mobile-menu" class="fixed inset-0 bg-[#FAF7F2] z-40 flex-col px-6 pt-24 pb-12 lg:hidden overflow-y-auto hidden opacity-0 transition-opacity duration-300">
    <nav class="flex flex-col gap-8 items-center mt-12 relative" id="mobile-nav">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="mobile-nav-link font-light text-3xl sm:text-4xl tracking-wide transition-colors text-[#1A1A1A]/60 hover:text-[#1A1A1A]"
          data-href={link.href}
        >
          {link.label}
        </a>
      ))}
      <!-- Mobile Magic Underline -->
      <div id="mobile-magic-underline" class="absolute h-[1.5px] bg-[#1A1A1A] transition-all duration-300 ease-out opacity-0 pointer-events-none"></div>

      <div class="h-px bg-[#1A1A1A]/10 w-24 my-8"></div>
      <a href="https://t.me/floral_studio_odesa" target="_blank" rel="noopener noreferrer" class="text-xs uppercase tracking-[0.2em] font-medium text-[#1A1A1A] hover:opacity-70 transition-opacity">
        Telegram консультація
      </a>
      <a href="tel:+380671234567" class="text-xs uppercase tracking-[0.2em] font-medium text-[#1A1A1A] hover:opacity-70 transition-opacity">
        +38 (067) 123-45-67
      </a>
    </nav>
  </div>
</header>

<script>
  import { $cartCount, toggleCart } from '../stores/cartStore';

  let initialized = false;
  let isMenuOpen = false;

  const updateActiveNav = () => {
    const currentPath = window.location.pathname;
    let activeFound = false;
    
    const navLinks = document.querySelectorAll('.nav-link');
    const mobileNavLinks = document.querySelectorAll('.mobile-nav-link');
    const magicUnderline = document.getElementById('magic-underline');

    navLinks.forEach((link) => {
      const href = link.getAttribute('data-href');
      if (href && href !== '/' && currentPath.startsWith(href)) {
        link.classList.add('text-[#1A1A1A]');
        link.classList.remove('text-[#1A1A1A]/60');
        
        if (magicUnderline) {
          const rect = link.getBoundingClientRect();
          const parentRect = link.parentElement?.getBoundingClientRect();
          if (parentRect) {
            magicUnderline.style.width = `${rect.width}px`;
            magicUnderline.style.left = `${rect.left - parentRect.left}px`;
            magicUnderline.style.opacity = '1';
          }
        }
        activeFound = true;
      } else {
        link.classList.remove('text-[#1A1A1A]');
        link.classList.add('text-[#1A1A1A]/60');
      }
    });

    if (!activeFound && magicUnderline) {
      magicUnderline.style.opacity = '0';
    }

    let mobileActiveFound = false;
    const mobileMagicUnderline = document.getElementById('mobile-magic-underline');

    mobileNavLinks.forEach((link) => {
      const href = link.getAttribute('data-href');
      if (href && href !== '/' && currentPath.startsWith(href)) {
        link.classList.add('text-[#1A1A1A]');
        link.classList.remove('text-[#1A1A1A]/60');
        
        if (mobileMagicUnderline) {
          const rect = link.getBoundingClientRect();
          const parentRect = link.parentElement?.getBoundingClientRect();
          if (parentRect) {
            mobileMagicUnderline.style.width = `${rect.width}px`;
            // Add a small offset to put the line right below the text
            mobileMagicUnderline.style.top = `${rect.bottom - parentRect.top + 4}px`;
            mobileMagicUnderline.style.left = `${rect.left - parentRect.left}px`;
            mobileMagicUnderline.style.opacity = '1';
          }
        }
        mobileActiveFound = true;
      } else {
        link.classList.remove('text-[#1A1A1A]');
        link.classList.add('text-[#1A1A1A]/60');
      }
    });

    if (!mobileActiveFound && mobileMagicUnderline) {
      mobileMagicUnderline.style.opacity = '0';
    }
  };

  const initHeader = () => {
    if (initialized) {
      updateActiveNav();
      return;
    }
    initialized = true;

    const header = document.getElementById('site-header');
    const mobileMenu = document.getElementById('mobile-menu');
    const mobileMenuToggle = document.getElementById('mobile-menu-toggle');
    const menuIcon = document.getElementById('menu-icon');
    const closeIcon = document.getElementById('close-icon');
    const cartToggle = document.getElementById('cart-toggle');
    const cartBadge = document.getElementById('cart-badge');
    const brandLogo = document.getElementById('brand-logo');
    const mobileNavLinks = document.querySelectorAll('.mobile-nav-link');

    // Scroll listener
    const handleScroll = () => {
      if (window.scrollY > 20 && !isMenuOpen) {
        header?.classList.add('py-4', 'shadow-sm');
        header?.classList.remove('py-6');
      } else {
        header?.classList.add('py-6');
        header?.classList.remove('py-4', 'shadow-sm');
      }
    };
    window.addEventListener('scroll', handleScroll, { passive: true });
    handleScroll();

    // Mobile menu toggle
    const toggleMenu = (forceClose = false) => {
      if (forceClose && !isMenuOpen) return;
      isMenuOpen = forceClose ? false : !isMenuOpen;
      
      if (isMenuOpen) {
        mobileMenu?.classList.remove('hidden');
        // trigger reflow
        void mobileMenu?.offsetWidth;
        mobileMenu?.classList.remove('opacity-0');
        menuIcon?.classList.add('hidden');
        closeIcon?.classList.remove('hidden');
        document.documentElement.classList.add('lock-scroll');
        header?.classList.add('py-6');
        header?.classList.remove('py-4', 'shadow-sm');
      } else {
        mobileMenu?.classList.add('opacity-0');
        setTimeout(() => {
          if (!isMenuOpen) mobileMenu?.classList.add('hidden');
        }, 300);
        menuIcon?.classList.remove('hidden');
        closeIcon?.classList.add('hidden');
        document.documentElement.classList.remove('lock-scroll');
        handleScroll();
      }
    };

    mobileMenuToggle?.addEventListener('click', () => toggleMenu());
    brandLogo?.addEventListener('click', () => toggleMenu(true));
    mobileNavLinks.forEach(link => {
      link.addEventListener('click', () => toggleMenu(true));
    });

    // Cart Store Subscription
    $cartCount.subscribe((count) => {
      if (cartBadge) {
        if (count > 0) {
          cartBadge.textContent = count.toString();
          cartBadge.classList.remove('hidden');
        } else {
          cartBadge.classList.add('hidden');
        }
      }
    });

    cartToggle?.addEventListener('click', () => {
      toggleMenu(true);
      toggleCart(true);
    });

    // Close menu on astro navigation
    document.addEventListener('astro:after-swap', () => {
      toggleMenu(true);
    });

    updateActiveNav();
  };

  document.addEventListener('astro:page-load', initHeader);
</script>

