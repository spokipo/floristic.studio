---
import Layout from '../layouts/Layout.astro';
import { BookingTriggerButton } from '../components/BookingTriggerButton';
import { FloatingBookingButton } from '../components/FloatingBookingButton';
import { FadeIn } from '../components/FadeIn';
import { ImageCarousel } from '../components/ImageCarousel';

const gallery = [
  "https://images.unsplash.com/photo-1634547588713-edd93045b9f1?w=800&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwcm9maWxlLXBhZ2V8MXx8fGVufDB8fHx8fA%3D%3D",
  "https://images.unsplash.com/photo-1634547532213-a4b8d7ff8927?w=800&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwcm9maWxlLXBhZ2V8Mnx8fGVufDB8fHx8fA%3D%3D",
  "https://images.unsplash.com/photo-1634547476021-c1155c01616c?w=800&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwcm9maWxlLXBhZ2V8M3x8fGVufDB8fHx8fA%3D%3D",
  "https://images.unsplash.com/photo-1633505899118-4ca6bd143043?w=800&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwcm9maWxlLXBhZ2V8NHx8fGVufDB8fHx8fA%3D%3D",
  "https://images.unsplash.com/photo-1633505765486-e404bbbec654?w=800&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwcm9maWxlLXBhZ2V8NXx8fGVufDB8fHx8fA%3D%3D",
  "https://images.unsplash.com/photo-1633505650701-6104c4fc72c2?w=800&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwcm9maWxlLXBhZ2V8Nnx8fGVufDB8fHx8fA%3D%3D"
];

const carousel = [
  "https://images.unsplash.com/photo-1634547476021-c1155c01616c?w=800&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwcm9maWxlLXBhZ2V8M3x8fGVufDB8fHx8fA%3D%3D",
  "https://images.unsplash.com/photo-1633505765486-e404bbbec654?w=800&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwcm9maWxlLXBhZ2V8NXx8fGVufDB8fHx8fA%3D%3D",
  "https://images.unsplash.com/photo-1634547588713-edd93045b9f1?w=800&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwcm9maWxlLXBhZ2V8MXx8fGVufDB8fHx8fA%3D%3D",
  "https://images.unsplash.com/photo-1634547532213-a4b8d7ff8927?w=800&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwcm9maWxlLXBhZ2V8Mnx8fGVufDB8fHx8fA%3D%3D"
];
---

<Layout
  title="Простір — Фотостудія при майстерні | Floral Studio Одеса"
  description="Фотостудія з натуральним світлом при квітковій майстерні в Одесі. Фотосесії з квітами та без, предметна зйомка для брендів. Запишіться онлайн."
>
  {/* Editorial Header */}
  <section class="pt-32 pb-16 sm:pt-40 sm:pb-24">
    {/* Title Block */}
    <div class="max-w-7xl mx-auto px-6 lg:px-8 text-center mb-16 sm:mb-24">
      <FadeIn client:load>
        <p class="text-[10px] sm:text-xs uppercase tracking-widest font-medium text-[#1A1A1A]/50 mb-3">
          Фотостудія Простір
        </p>
        <h1 class="font-normal text-4xl sm:text-5xl text-[#1A1A1A] mb-4">
          Світло, квіти<br class="hidden sm:block" /> та натхнення
        </h1>
        <p class="text-sm font-light text-[#1A1A1A]/70 max-w-2xl mx-auto mb-10">
          Простір з натуральним світлом при квітковій майстерні. Для створення особливих кадрів та естетичного контенту.
        </p>
        <BookingTriggerButton
          client:load
          id="hero-booking-btn"
          className="inline-flex items-center gap-3 px-10 py-5 bg-[#1A1A1A] text-white text-[10px] sm:text-xs uppercase tracking-[0.2em] font-medium transition-all hover:bg-black hover:scale-105 active:scale-95"
        >
          <span>Записатися онлайн</span>
        </BookingTriggerButton>
      </FadeIn>
    </div>

    {/* Hero Carousel */}
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-20 sm:mb-32">
      <FadeIn client:load delay={0.2}>
        <ImageCarousel client:load images={carousel} />
      </FadeIn>
    </div>

    {/* About details (Two column editorial text) */}
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <hr class="border-t border-[#1A1A1A]/10 w-full mb-16 sm:mb-24" />
      <div class="grid grid-cols-1 md:grid-cols-12 gap-12 sm:gap-16 lg:gap-24 items-start">
        <div class="md:col-span-5 lg:col-span-6">
          <h2 class="text-2xl sm:text-3xl text-[#1A1A1A] font-light leading-relaxed">
            Наш простір — це 60 м² чистої естетики. Великі вікна, теплі відтінки та авторські квіткові композиції створюють ідеальну атмосферу.
          </h2>
        </div>
        
        <div class="md:col-span-7 lg:col-span-6 space-y-8">
          <p class="text-sm text-[#1A1A1A]/70 font-light leading-relaxed">
            Студія розташована прямо при майстерні, тому у вас є унікальна можливість знімати серед свіжих квітів. 
            Мінімалістичний інтер'єр дозволяє зосередити увагу на головному — на вас та ваших емоціях.
          </p>
          
          <div class="border-t border-[#1A1A1A]/10 pt-8 space-y-4 text-sm font-light text-[#1A1A1A]/70">
            <div class="flex justify-between items-center border-b border-[#1A1A1A]/5 pb-4">
              <span class="uppercase tracking-widest text-xs font-medium text-[#1A1A1A]">Площа</span>
              <span>60 м² (висота стель 4м)</span>
            </div>
            <div class="flex justify-between items-center border-b border-[#1A1A1A]/5 pb-4">
              <span class="uppercase tracking-widest text-xs font-medium text-[#1A1A1A]">Світло</span>
              <span>Природне (великі вікна)</span>
            </div>
            <div class="flex justify-between items-center pb-4">
              <span class="uppercase tracking-widest text-xs font-medium text-[#1A1A1A]">Оренда</span>
              <span>Від 800 ₴ / година</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* Shoot Formats */}
  <section class="py-16 sm:py-24 border-t border-[#1A1A1A]/10">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <p class="text-[10px] sm:text-xs uppercase tracking-widest font-medium text-[#1A1A1A]/50 mb-4">Послуги</p>
        <h2 class="font-normal text-4xl sm:text-5xl text-[#1A1A1A] mb-4">
          Формати зйомки
        </h2>
        <p class="text-sm font-light text-[#1A1A1A]/60">
          Оберіть формат або зв'яжіться з нами для індивідуального сет-дизайну
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-12 lg:gap-16">
        <div class="group flex flex-col justify-between">
          <div>
            <div class="overflow-hidden mb-6 aspect-[3/4]">
              <img
                src="https://images.unsplash.com/photo-1787469240869-519ca2a6c39d?w=800&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwcm9maWxlLXBhZ2V8NXx8fGVufDB8fHx8fA%3D%3D"
                alt="Фотосесія з квітами"
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
              />
            </div>
            <h3 class="font-normal text-2xl text-[#1A1A1A] mb-3">З квітами</h3>
            <p class="text-sm font-light text-[#1A1A1A]/70 mb-4 leading-relaxed">
              Фотосесія з авторською флористичною декорацією. Ми підберемо квіти під вашу кольорову гаму та настрій.
            </p>
            <div class="text-xs uppercase tracking-widest text-[#1A1A1A]/50 mb-8">від 2 500 ₴ / 1 год</div>
          </div>
          <BookingTriggerButton
            client:load
            shootType="flowers"
            className="w-full py-3.5 border border-[#1A1A1A]/20 text-[#1A1A1A] hover:border-[#1A1A1A] hover:bg-black/5 transition-colors text-[10px] sm:text-xs uppercase tracking-widest font-medium text-center"
          >
            Обрати цей формат
          </BookingTriggerButton>
        </div>

        <div class="group flex flex-col justify-between">
          <div>
            <div class="overflow-hidden mb-6 aspect-[3/4]">
              <img
                src="https://images.unsplash.com/photo-1634547588713-edd93045b9f1?w=800&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwcm9maWxlLXBhZ2V8MXx8fGVufDB8fHx8fA%3D%3D"
                alt="Зйомка у чистому просторі"
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
              />
            </div>
            <h3 class="font-normal text-2xl text-[#1A1A1A] mb-3">Без квітів</h3>
            <p class="text-sm font-light text-[#1A1A1A]/70 mb-4 leading-relaxed">
              Чистий мінімалістичний простір із натуральним світлом. Для портретів, сімейних та корпоративних зйомки.
            </p>
            <div class="text-xs uppercase tracking-widest text-[#1A1A1A]/50 mb-8">від 1 200 ₴ / 1 год</div>
          </div>
          <BookingTriggerButton
            client:load
            shootType="no_flowers"
            className="w-full py-3.5 border border-[#1A1A1A]/20 text-[#1A1A1A] hover:border-[#1A1A1A] hover:bg-black/5 transition-colors text-[10px] sm:text-xs uppercase tracking-widest font-medium text-center"
          >
            Обрати цей формат
          </BookingTriggerButton>
        </div>

        <div class="group flex flex-col justify-between">
          <div>
            <div class="overflow-hidden mb-6 aspect-[3/4]">
              <img
                src="https://images.unsplash.com/photo-1616046619793-7e4badf3fe1f?w=700&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwcm9maWxlLXBhZ2V8MTM5fHx8ZW58MHx8fHx8"
                alt="Контент-зйомка для брендів"
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
              />
            </div>
            <h3 class="font-normal text-2xl text-[#1A1A1A] mb-3">Контент-зйомка</h3>
            <p class="text-sm font-light text-[#1A1A1A]/70 mb-4 leading-relaxed">
              Предметна та флет-лей зйомка для блогерів, брендів та онлайн-магазинів. Ідеальний фон і реквізит.
            </p>
            <div class="text-xs uppercase tracking-widest text-[#1A1A1A]/50 mb-8">від 800 ₴ / 30 хв</div>
          </div>
          <BookingTriggerButton
            client:load
            shootType="content"
            className="w-full py-3.5 border border-[#1A1A1A]/20 text-[#1A1A1A] hover:border-[#1A1A1A] hover:bg-black/5 transition-colors text-[10px] sm:text-xs uppercase tracking-widest font-medium text-center"
          >
            Обрати цей формат
          </BookingTriggerButton>
        </div>
      </div>
    </div>
  </section>

  {/* Gallery */}
  <section class="py-16 sm:py-24 border-t border-[#1A1A1A]/10">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="text-center mb-16">
        <p class="text-[10px] sm:text-xs uppercase tracking-widest font-medium text-[#1A1A1A]/50 mb-4">Портфоліо</p>
        <h2 class="font-normal text-4xl sm:text-5xl text-[#1A1A1A] mb-4">
          Атмосфера простору
        </h2>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 gap-3 sm:gap-4">
        {gallery.map((src, idx) => (
          <img src={src} alt={`Студія ${idx + 1}`} class="w-full aspect-square object-cover" />
        ))}
      </div>
    </div>
  </section>

  <FloatingBookingButton client:load />
</Layout>
